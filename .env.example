# Template — commit this, never .env itself. Copy to .env and fill in locally.

# Postgres (Supabase) — source of truth for law/article text.
# Supabase dashboard: Project Settings -> Database -> Connection string
# (use the Transaction pooler string, not the direct host).
DATABASE_URL=

# Supabase project URL + publishable key. NEXT_PUBLIC_ prefix is required —
# only prefixed vars get bundled into client-side JS (needed by
# lib/supabase/client.ts and middleware.ts).
# Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pinecone (vector DB — embeddings only). Index must already be populated;
# this repo is the app only, not the ingestion pipeline.
PINECONE_API_KEY=
PINECONE_INDEX=

# LLM fallback chain for RAG generation: Gemini -> Groq -> OpenRouter.
# All three are free-tier; no paid LLM dependency.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
